+        else if (op == INTERPRETER_TRANSLATE(mov) || op == INTERPRETER_TRANSLATE(cpy))
+            shifter_operand = &((mov_inst*)inst_base->component)->shifter_operand;
+        else
+            shifter_operand = &((add_inst*)inst_base->component)->shifter_operand;
+        *shifter_operand = operand;
