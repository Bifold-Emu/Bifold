index 729c407..632252e 100644
--- a/src/core/arm/dyncom/arm_dyncom_trans.cpp
+++ b/src/core/arm/dyncom/arm_dyncom_trans.cpp
@@ -1,4 +1,5 @@
 #include <cstdlib>
+#include <vector>
 #include "common/assert.h"
 #include "common/common_types.h"
 #include "core/arm/dyncom/arm_dyncom_trans.h"
@@ -9,6 +10,34 @@
 char trans_cache_buf[TRANS_CACHE_SIZE];
 size_t trans_cache_buf_top = 0;
 
+namespace {
+std::vector<ARMul_State*> trans_cache_users;
+// A block ends at a branch or a page boundary: at most 2048 Thumb instructions, each well under
+// 256 bytes once translated.
+constexpr std::size_t TRANS_CACHE_MARGIN = 1024 * 1024;
+} // namespace
+
+void RegisterTransCacheUser(ARMul_State* state) {
+    trans_cache_users.push_back(state);
+}
+
+void UnregisterTransCacheUser(ARMul_State* state) {
+    std::erase(trans_cache_users, state);
+    if (trans_cache_users.empty()) {
+        trans_cache_buf_top = 0;
+    }
+}
+
+void EnsureTransCacheSpace() {
+    if (trans_cache_buf_top + TRANS_CACHE_MARGIN <= TRANS_CACHE_SIZE) {
+        return;
+    }
+    for (ARMul_State* state : trans_cache_users) {
+        state->ClearBlockCache();
+    }
+    trans_cache_buf_top = 0;
+}
+
 static void* AllocBuffer(std::size_t size) {
     std::size_t start = trans_cache_buf_top;
     trans_cache_buf_top += size;
