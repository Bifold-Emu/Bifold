+++ b/src/core/arm/skyeye_common/vfp/vfp_native.h
@@ -0,0 +1,602 @@
+// Bifold: run VFP data-processing instructions on the host FPU (AArch64 only).
+//
+// The guest FPSCR's DN, FZ and RMode bits sit at the same positions as the host FPCR's, and its
+// cumulative exception bits (IOC, DZC, OFC, UFC, IXC, IDC) at the same positions as the host
+// FPSR's. Writing FPCR or reading FPSR stalls the pipeline (a set/restore pair costs about 40 ns
+// on Apple cores, more than the software emulation of an add), so the mode is not switched per
+// instruction. At the first VFP instruction of an InterpreterMainLoop run (Enter) the host FPCR
+// takes the guest's mode, and from then on the host FPSR collects the guest's exception flags.
+// They are folded back into FPSCR (Leave) when the loop returns, when the guest reads FPSCR, and
+// before guest code calls into the rest of the emulator (HostCall: SVCs, MMIO and other slow
+// memory accesses), which must run in the host's own mode. Every floating-point instruction here
+// is inline asm volatile, so the compiler cannot move it across a mode change. Short vectors
+// (FPSCR.LEN != 0) fall back to the software implementation.
+#pragma once
+
+#if defined(__aarch64__)
+#define AZ_VFP_NATIVE 1
+
+#include <atomic>
+#include <bit>
+#include "common/common_types.h"
+#include "core/arm/skyeye_common/armstate.h"
+#include "core/arm/skyeye_common/vfp/asm_vfp.h"
+#include "core/arm/skyeye_common/vfp/vfp_helper.h"
+#include "core/arm/skyeye_common/vfp/vfp_native_op.h"
+
+namespace VfpNative {
+
+// Cleared by AZ_VFP_SOFT=1 at startup, or at run time through az_debug_vfp_native().
+extern std::atomic<bool> enabled;
+// Use the operands decoded at translation time (Op) instead of decoding each time (A/B switch).
+extern std::atomic<bool> predecoded;
+
+constexpr u32 MODE_MASK = 0x07C00000; // AHP, DN, FZ, RMode
+constexpr u32 EXC_MASK = 0x9F;        // IDC, IXC, UFC, OFC, DZC, IOC
+
+#define AZ_FORCE_INLINE [[gnu::always_inline]] inline
+
+AZ_FORCE_INLINE u64 ReadFpcr() {
+    u64 v;
+    asm volatile("mrs %0, fpcr" : "=r"(v));
+    return v;
+}
+AZ_FORCE_INLINE void WriteFpcr(u64 v) {
+    asm volatile("msr fpcr, %0" : : "r"(v) : "memory");
+}
+AZ_FORCE_INLINE u64 ReadFpsr() {
+    u64 v;
+    asm volatile("mrs %0, fpsr" : "=r"(v));
+    return v;
+}
+AZ_FORCE_INLINE void WriteFpsr(u64 v) {
+    asm volatile("msr fpsr, %0" : : "r"(v) : "memory");
+}
+
+// Host FPU -> guest: fold the exception flags collected so far into FPSCR.
+AZ_FORCE_INLINE void Store(ARMul_State* s) {
+    const u32 flags = static_cast<u32>(ReadFpsr()) & EXC_MASK;
+    if (flags)
+        s->VFP[VFP_FPSCR] |= flags;
+}
+
+// Guest -> host FPU: the guest's mode, no flags pending (they are all in FPSCR already).
+AZ_FORCE_INLINE void Load(ARMul_State* s) {
+    WriteFpsr(0);
+    const u64 mode = s->VFP[VFP_FPSCR] & MODE_MASK;
+    if (ReadFpcr() != mode)
+        WriteFpcr(mode);
+}
+
+// Switch the host FPU to the guest (first VFP instruction of a run) and back.
+inline void Enter(ARMul_State* s) {
+    s->vfp_host_fpcr = ReadFpcr();
+    Load(s);
+    s->vfp_live = true;
+}
+inline void Leave(ARMul_State* s) {
+    Store(s);
+    WriteFpcr(s->vfp_host_fpcr);
+    s->vfp_live = false;
+}
+
+// Lives for one InterpreterMainLoop call: allows the host FPU path; the switch itself happens at
+// the first VFP instruction, so runs without floating point pay nothing.
+class GuestWindow {
+public:
+    explicit GuestWindow(ARMul_State* state) : s(state) {
+        s->vfp_window = enabled.load(std::memory_order_relaxed);
+    }
+    ~GuestWindow() {
+        if (s->vfp_live)
+            Leave(s);
+        s->vfp_window = false;
+    }
+    GuestWindow(const GuestWindow&) = delete;
+    GuestWindow& operator=(const GuestWindow&) = delete;
+
+private:
+    ARMul_State* s;
+};
+
+// Before a call from guest code into host code that may use floating point. The next VFP
+// instruction switches back.
+AZ_FORCE_INLINE void HostCall(ARMul_State* s) {
+    if (s->vfp_live)
+        Leave(s);
+}
+
+#define AZ_VN_BIN(name, insn)                                                                      \
+    AZ_FORCE_INLINE float name(float a, float b) {                                                 \
+        float r;                                                                                   \
+        asm volatile(insn " %s0, %s1, %s2" : "=w"(r) : "w"(a), "w"(b));                            \
+        return r;                                                                                  \
+    }                                                                                              \
+    AZ_FORCE_INLINE double name(double a, double b) {                                              \
+        double r;                                                                                  \
+        asm volatile(insn " %d0, %d1, %d2" : "=w"(r) : "w"(a), "w"(b));                            \
+        return r;                                                                                  \
+    }
+AZ_VN_BIN(Add, "fadd")
+AZ_VN_BIN(Sub, "fsub")
+AZ_VN_BIN(Mul, "fmul")
+AZ_VN_BIN(Div, "fdiv")
+#undef AZ_VN_BIN
+
+AZ_FORCE_INLINE float Sqrt(float a) {
+    float r;
+    asm volatile("fsqrt %s0, %s1" : "=w"(r) : "w"(a));
+    return r;
+}
+AZ_FORCE_INLINE double Sqrt(double a) {
+    double r;
+    asm volatile("fsqrt %d0, %d1" : "=w"(r) : "w"(a));
+    return r;
+}
+
+// FPNeg only flips the sign bit (no flush, no exceptions), so do it on the integer bits.
+AZ_FORCE_INLINE float Neg(float a) {
+    return std::bit_cast<float>(std::bit_cast<u32>(a) ^ 0x80000000u);
+}
+AZ_FORCE_INLINE double Neg(double a) {
+    return std::bit_cast<double>(std::bit_cast<u64>(a) ^ 0x8000000000000000ull);
+}
+
+// Comparisons return the host NZCV, which uses the same encoding as FPSCR[31:28].
+template <bool E, typename T>
+AZ_FORCE_INLINE u32 Cmp(T a, T b) {
+    u64 f;
+    if constexpr (sizeof(T) == 4) {
+        if constexpr (E)
+            asm volatile("fcmpe %s1, %s2\n\tmrs %0, nzcv" : "=r"(f) : "w"(a), "w"(b) : "cc");
+        else
+            asm volatile("fcmp %s1, %s2\n\tmrs %0, nzcv" : "=r"(f) : "w"(a), "w"(b) : "cc");
+    } else {
+        if constexpr (E)
+            asm volatile("fcmpe %d1, %d2\n\tmrs %0, nzcv" : "=r"(f) : "w"(a), "w"(b) : "cc");
+        else
+            asm volatile("fcmp %d1, %d2\n\tmrs %0, nzcv" : "=r"(f) : "w"(a), "w"(b) : "cc");
+    }
+    return static_cast<u32>(f);
+}
+
+template <bool E, typename T>
+AZ_FORCE_INLINE u32 CmpZero(T a) {
+    u64 f;
+    if constexpr (sizeof(T) == 4) {
+        if constexpr (E)
+            asm volatile("fcmpe %s1, #0.0\n\tmrs %0, nzcv" : "=r"(f) : "w"(a) : "cc");
+        else
+            asm volatile("fcmp %s1, #0.0\n\tmrs %0, nzcv" : "=r"(f) : "w"(a) : "cc");
+    } else {
+        if constexpr (E)
+            asm volatile("fcmpe %d1, #0.0\n\tmrs %0, nzcv" : "=r"(f) : "w"(a) : "cc");
+        else
+            asm volatile("fcmp %d1, #0.0\n\tmrs %0, nzcv" : "=r"(f) : "w"(a) : "cc");
+    }
+    return static_cast<u32>(f);
+}
+
+// Float -> 32-bit integer. round: 0 = FPSCR mode, 1 = toward zero.
+template <bool Signed, typename T>
+AZ_FORCE_INLINE u32 ToInt(T a, u32 rmode) {
+    u32 r;
+#define AZ_VN_CVT(op)                                                                              \
+    if constexpr (sizeof(T) == 4)                                                                  \
+        asm volatile(op " %w0, %s1" : "=r"(r) : "w"(a));                                           \
+    else                                                                                           \
+        asm volatile(op " %w0, %d1" : "=r"(r) : "w"(a));
+    if constexpr (Signed) {
+        switch (rmode) {
+        case 0: AZ_VN_CVT("fcvtns") break;
+        case 1: AZ_VN_CVT("fcvtps") break;
+        case 2: AZ_VN_CVT("fcvtms") break;
+        default: AZ_VN_CVT("fcvtzs") break;
+        }
+    } else {
+        switch (rmode) {
+        case 0: AZ_VN_CVT("fcvtnu") break;
+        case 1: AZ_VN_CVT("fcvtpu") break;
+        case 2: AZ_VN_CVT("fcvtmu") break;
+        default: AZ_VN_CVT("fcvtzu") break;
+        }
+    }
+#undef AZ_VN_CVT
+    return r;
+}
+
+template <bool Signed, typename T>
+AZ_FORCE_INLINE T FromInt(u32 v) {
+    T r;
+    if constexpr (sizeof(T) == 4) {
+        if constexpr (Signed)
+            asm volatile("scvtf %s0, %w1" : "=w"(r) : "r"(v));
+        else
+            asm volatile("ucvtf %s0, %w1" : "=w"(r) : "r"(v));
+    } else {
+        if constexpr (Signed)
+            asm volatile("scvtf %d0, %w1" : "=w"(r) : "r"(v));
+        else
+            asm volatile("ucvtf %d0, %w1" : "=w"(r) : "r"(v));
+    }
+    return r;
+}
+
+AZ_FORCE_INLINE double ToDouble(float a) {
+    double r;
+    asm volatile("fcvt %d0, %s1" : "=w"(r) : "w"(a));
+    return r;
+}
+AZ_FORCE_INLINE float ToSingle(double a) {
+    float r;
+    asm volatile("fcvt %s0, %d1" : "=w"(r) : "w"(a));
+    return r;
+}
+
+AZ_FORCE_INLINE float GetS(const ARMul_State* s, u32 r) {
+    return std::bit_cast<float>(s->ExtReg[r]);
+}
+AZ_FORCE_INLINE void PutS(ARMul_State* s, u32 r, float v) {
+    s->ExtReg[r] = std::bit_cast<u32>(v);
+}
+AZ_FORCE_INLINE double GetD(const ARMul_State* s, u32 r) {
+    return std::bit_cast<double>(static_cast<u64>(s->ExtReg[r * 2 + 1]) << 32 |
+                                 s->ExtReg[r * 2]);
+}
+AZ_FORCE_INLINE void PutD(ARMul_State* s, u32 r, double v) {
+    const u64 b = std::bit_cast<u64>(v);
+    s->ExtReg[r * 2] = static_cast<u32>(b);
+    s->ExtReg[r * 2 + 1] = static_cast<u32>(b >> 32);
+}
+
+// Arithmetic shared by single and double precision. FOP_TO_IDX order:
+// 0 VMLA, 1 VNMLS, 2 VMUL, 3 VADD, 4 VMLS, 5 VNMLA, 6 VNMUL, 7 VSUB, 8 VDIV.
+template <typename T>
+AZ_FORCE_INLINE bool Arith(u32 idx, T d, T n, T m, T& r) {
+    switch (idx) {
+    case 0: r = Add(d, Mul(n, m)); return true;
+    case 1: r = Add(Neg(d), Mul(n, m)); return true;
+    case 2: r = Mul(n, m); return true;
+    case 3: r = Add(n, m); return true;
+    case 4: r = Add(d, Neg(Mul(n, m))); return true;
+    case 5: r = Add(Neg(d), Neg(Mul(n, m))); return true;
+    case 6: r = Neg(Mul(n, m)); return true;
+    case 7: r = Sub(n, m); return true;
+    case 8: r = Div(n, m); return true;
+    default: return false;
+    }
+}
+
+// Only while the host FPU is in the guest mode (Enter). Returns false when the instruction should take the software path.
+// On success, `exc` is the new FPSCR NZCV for comparisons and 0 otherwise.
+inline bool Single(ARMul_State* s, u32 inst, u32 fpscr, u32& exc) {
+    const u32 sd = vfp_get_sd(inst);
+    const u32 sm = vfp_get_sm(inst);
+    const bool scalar = (fpscr & FPSCR_LENGTH_MASK) == 0 || (sd & 0x18) == 0;
+    if ((inst & FOP_MASK) != FOP_EXT) {
+        if (!scalar)
+            return false;
+        const float n = GetS(s, vfp_get_sn(inst)), m = GetS(s, sm), d = GetS(s, sd);
+        float r;
+        const bool ok = Arith(FOP_TO_IDX(inst), d, n, m, r);
+        exc = 0;
+        if (!ok)
+            return false;
+        PutS(s, sd, r);
+        return true;
+    }
+    const u32 rmode = (fpscr >> 22) & 3;
+    switch (FEXT_TO_IDX(inst)) {
+    case 0: // VMOV
+        if (!scalar)
+            return false;
+        s->ExtReg[sd] = s->ExtReg[sm];
+        exc = 0;
+        return true;
+    case 1: // VABS
+        if (!scalar)
+            return false;
+        s->ExtReg[sd] = s->ExtReg[sm] & 0x7FFFFFFF;
+        exc = 0;
+        return true;
+    case 2: // VNEG
+        if (!scalar)
+            return false;
+        s->ExtReg[sd] = s->ExtReg[sm] ^ 0x80000000;
+        exc = 0;
+        return true;
+    case 3: { // VSQRT
+        if (!scalar)
+            return false;
+        const float m = GetS(s, sm);
+        const float r = Sqrt(m);
+        exc = 0;
+        PutS(s, sd, r);
+        return true;
+    }
+    case 8:
+    case 9:
+    case 10:
+    case 11: { // VCMP, VCMPE, VCMP #0, VCMPE #0
+        const u32 idx = FEXT_TO_IDX(inst);
+        const float a = GetS(s, sd), b = GetS(s, sm);
+        u32 nzcv;
+        switch (idx) {
+        case 8: nzcv = Cmp<false>(a, b); break;
+        case 9: nzcv = Cmp<true>(a, b); break;
+        case 10: nzcv = CmpZero<false>(a); break;
+        default: nzcv = CmpZero<true>(a); break;
+        }
+        exc = nzcv & 0xF0000000;
+        return true;
+    }
+    case 15: { // VCVT.F64.F32
+        const float m = GetS(s, sm);
+        const double r = ToDouble(m);
+        exc = 0;
+        PutD(s, vfp_get_dd(inst), r);
+        return true;
+    }
+    case 16:
+    case 17: { // VCVT.F32.U32 / VCVT.F32.S32
+        const u32 v = s->ExtReg[sm];
+        const float r = FEXT_TO_IDX(inst) == 16 ? FromInt<false, float>(v) : FromInt<true, float>(v);
+        exc = 0;
+        PutS(s, sd, r);
+        return true;
+    }
+    case 24:
+    case 25:
+    case 26:
+    case 27: { // VCVT{R}.U32.F32 / VCVT{R}.S32.F32
+        const u32 idx = FEXT_TO_IDX(inst);
+        const float m = GetS(s, sm);
+        const u32 mode = (idx & 1) ? 3 : rmode;
+        const u32 r = idx >= 26 ? ToInt<true>(m, mode) : ToInt<false>(m, mode);
+        exc = 0;
+        s->ExtReg[sd] = r;
+        return true;
+    }
+    default:
+        return false;
+    }
+}
+
+inline bool Double(ARMul_State* s, u32 inst, u32 fpscr, u32& exc) {
+    const u32 dd = vfp_get_dd(inst);
+    const u32 dm = vfp_get_dm(inst);
+    const bool scalar = (fpscr & FPSCR_LENGTH_MASK) == 0 || (dd & 0x0c) == 0;
+    if ((inst & FOP_MASK) != FOP_EXT) {
+        if (!scalar)
+            return false;
+        const double n = GetD(s, vfp_get_dn(inst)), m = GetD(s, dm), d = GetD(s, dd);
+        double r;
+        const bool ok = Arith(FOP_TO_IDX(inst), d, n, m, r);
+        exc = 0;
+        if (!ok)
+            return false;
+        PutD(s, dd, r);
+        return true;
+    }
+    const u32 rmode = (fpscr >> 22) & 3;
+    switch (FEXT_TO_IDX(inst)) {
+    case 0: // VMOV
+        if (!scalar)
+            return false;
+        s->ExtReg[dd * 2] = s->ExtReg[dm * 2];
+        s->ExtReg[dd * 2 + 1] = s->ExtReg[dm * 2 + 1];
+        exc = 0;
+        return true;
+    case 1: // VABS
+        if (!scalar)
+            return false;
+        s->ExtReg[dd * 2] = s->ExtReg[dm * 2];
+        s->ExtReg[dd * 2 + 1] = s->ExtReg[dm * 2 + 1] & 0x7FFFFFFF;
+        exc = 0;
+        return true;
+    case 2: // VNEG
+        if (!scalar)
+            return false;
+        s->ExtReg[dd * 2] = s->ExtReg[dm * 2];
+        s->ExtReg[dd * 2 + 1] = s->ExtReg[dm * 2 + 1] ^ 0x80000000;
+        exc = 0;
+        return true;
+    case 3: { // VSQRT
+        if (!scalar)
+            return false;
+        const double m = GetD(s, dm);
+        const double r = Sqrt(m);
+        exc = 0;
+        PutD(s, dd, r);
+        return true;
+    }
+    case 8:
+    case 9:
+    case 10:
+    case 11: {
+        const u32 idx = FEXT_TO_IDX(inst);
+        const double a = GetD(s, dd), b = GetD(s, dm);
+        u32 nzcv;
+        switch (idx) {
+        case 8: nzcv = Cmp<false>(a, b); break;
+        case 9: nzcv = Cmp<true>(a, b); break;
+        case 10: nzcv = CmpZero<false>(a); break;
+        default: nzcv = CmpZero<true>(a); break;
+        }
+        exc = nzcv & 0xF0000000;
+        return true;
+    }
+    case 15: { // VCVT.F32.F64
+        const double m = GetD(s, dm);
+        const float r = ToSingle(m);
+        exc = 0;
+        PutS(s, vfp_get_sd(inst), r);
+        return true;
+    }
+    case 16:
+    case 17: { // VCVT.F64.U32 / VCVT.F64.S32 (source is a single register)
+        const u32 v = s->ExtReg[vfp_get_sm(inst)];
+        const double r =
+            FEXT_TO_IDX(inst) == 16 ? FromInt<false, double>(v) : FromInt<true, double>(v);
+        exc = 0;
+        PutD(s, dd, r);
+        return true;
+    }
+    case 24:
+    case 25:
+    case 26:
+    case 27: { // VCVT{R}.{U,S}32.F64 (destination is a single register)
+        const u32 idx = FEXT_TO_IDX(inst);
+        const double m = GetD(s, dm);
+        const u32 mode = (idx & 1) ? 3 : rmode;
+        const u32 r = idx >= 26 ? ToInt<true>(m, mode) : ToInt<false>(m, mode);
+        exc = 0;
+        s->ExtReg[vfp_get_sd(inst)] = r;
+        return true;
+    }
+    default:
+        return false;
+    }
+}
+
+#undef AZ_FORCE_INLINE
+
+
+// ---- Decoded at translation time ----------------------------------------------------------------
+// The interpreter keeps one Op per VFP data-processing instruction: a function for exactly that
+// operation and its register numbers, so running it skips the decoding in Single/Double.
+
+// Op and OpFn: vfp_native_op.h.
+
+template <u32 Idx>
+void ArithS(ARMul_State* s, const Op& o) {
+    float r;
+    Arith(Idx, GetS(s, o.d), GetS(s, o.n), GetS(s, o.m), r);
+    PutS(s, o.d, r);
+}
+template <u32 Idx>
+void ArithD(ARMul_State* s, const Op& o) {
+    double r;
+    Arith(Idx, GetD(s, o.d), GetD(s, o.n), GetD(s, o.m), r);
+    PutD(s, o.d, r);
+}
+inline void MovS(ARMul_State* s, const Op& o) {
+    s->ExtReg[o.d] = s->ExtReg[o.m];
+}
+inline void AbsS(ARMul_State* s, const Op& o) {
+    s->ExtReg[o.d] = s->ExtReg[o.m] & 0x7FFFFFFF;
+}
+inline void NegS(ARMul_State* s, const Op& o) {
+    s->ExtReg[o.d] = s->ExtReg[o.m] ^ 0x80000000;
+}
+inline void SqrtS(ARMul_State* s, const Op& o) {
+    PutS(s, o.d, Sqrt(GetS(s, o.m)));
+}
+inline void SqrtD(ARMul_State* s, const Op& o) {
+    PutD(s, o.d, Sqrt(GetD(s, o.m)));
+}
+template <typename T, bool E, bool Zero>
+void CmpOp(ARMul_State* s, const Op& o) {
+    u32 nzcv;
+    if constexpr (sizeof(T) == 4) {
+        nzcv = Zero ? CmpZero<E>(GetS(s, o.d)) : Cmp<E>(GetS(s, o.d), GetS(s, o.m));
+    } else {
+        nzcv = Zero ? CmpZero<E>(GetD(s, o.d)) : Cmp<E>(GetD(s, o.d), GetD(s, o.m));
+    }
+    s->VFP[VFP_FPSCR] = (s->VFP[VFP_FPSCR] & 0x0FFFFFFF) | (nzcv & 0xF0000000);
+}
+inline void CvtSD(ARMul_State* s, const Op& o) { // F64 <- F32
+    PutD(s, o.d, ToDouble(GetS(s, o.m)));
+}
+inline void CvtDS(ARMul_State* s, const Op& o) { // F32 <- F64
+    PutS(s, o.d, ToSingle(GetD(s, o.m)));
+}
+template <typename T, bool Signed>
+void FromIntOp(ARMul_State* s, const Op& o) {
+    const T r = FromInt<Signed, T>(s->ExtReg[o.m]);
+    if constexpr (sizeof(T) == 4)
+        PutS(s, o.d, r);
+    else
+        PutD(s, o.d, r);
+}
+template <typename T, bool Signed, bool TowardZero>
+void ToIntOp(ARMul_State* s, const Op& o) {
+    const u32 mode = TowardZero ? 3 : (s->VFP[VFP_FPSCR] >> 22) & 3;
+    if constexpr (sizeof(T) == 4)
+        s->ExtReg[o.d] = ToInt<Signed>(GetS(s, o.m), mode);
+    else
+        s->ExtReg[o.d] = ToInt<Signed>(GetD(s, o.m), mode);
+}
+
+// Same decoding as Single/Double, done once.
+inline Op Decode(u32 inst, bool dp) {
+    Op o;
+    if ((inst & FOP_MASK) != FOP_EXT) {
+        static constexpr OpFn single[9] = {ArithS<0>, ArithS<1>, ArithS<2>, ArithS<3>, ArithS<4>,
+                                           ArithS<5>, ArithS<6>, ArithS<7>, ArithS<8>};
+        static constexpr OpFn dbl[9] = {ArithD<0>, ArithD<1>, ArithD<2>, ArithD<3>, ArithD<4>,
+                                        ArithD<5>, ArithD<6>, ArithD<7>, ArithD<8>};
+        const u32 idx = FOP_TO_IDX(inst);
+        if (idx > 8)
+            return o;
+        o.fn = dp ? dbl[idx] : single[idx];
+        o.d = dp ? vfp_get_dd(inst) : vfp_get_sd(inst);
+        o.n = dp ? vfp_get_dn(inst) : vfp_get_sn(inst);
+        o.m = dp ? vfp_get_dm(inst) : vfp_get_sm(inst);
+        o.any_len = dp ? (o.d & 0x0c) == 0 : (o.d & 0x18) == 0;
+        return o;
+    }
+    const u32 idx = FEXT_TO_IDX(inst);
+    if (idx <= 3) { // VMOV, VABS, VNEG, VSQRT (vector-capable)
+        o.d = dp ? vfp_get_dd(inst) : vfp_get_sd(inst);
+        o.m = dp ? vfp_get_dm(inst) : vfp_get_sm(inst);
+        o.any_len = dp ? (o.d & 0x0c) == 0 : (o.d & 0x18) == 0;
+        if (dp)
+            o.fn = idx == 3 ? SqrtD : nullptr; // double VMOV/VABS/VNEG stay with VfpCpdo
+        else
+            o.fn = idx == 0 ? MovS : idx == 1 ? AbsS : idx == 2 ? NegS : SqrtS;
+        return o;
+    }
+    o.any_len = true;
+    switch (idx) {
+    case 8: case 9: case 10: case 11:
+        o.d = dp ? vfp_get_dd(inst) : vfp_get_sd(inst);
+        o.m = dp ? vfp_get_dm(inst) : vfp_get_sm(inst);
+        if (dp)
+            o.fn = idx == 8 ? CmpOp<double, false, false> : idx == 9 ? CmpOp<double, true, false>
+                 : idx == 10 ? CmpOp<double, false, true> : CmpOp<double, true, true>;
+        else
+            o.fn = idx == 8 ? CmpOp<float, false, false> : idx == 9 ? CmpOp<float, true, false>
+                 : idx == 10 ? CmpOp<float, false, true> : CmpOp<float, true, true>;
+        return o;
+    case 15:
+        o.d = dp ? vfp_get_sd(inst) : vfp_get_dd(inst);
+        o.m = dp ? vfp_get_dm(inst) : vfp_get_sm(inst);
+        o.fn = dp ? CvtDS : CvtSD;
+        return o;
+    case 16: case 17:
+        o.d = dp ? vfp_get_dd(inst) : vfp_get_sd(inst);
+        o.m = vfp_get_sm(inst);
+        if (dp)
+            o.fn = idx == 16 ? FromIntOp<double, false> : FromIntOp<double, true>;
+        else
+            o.fn = idx == 16 ? FromIntOp<float, false> : FromIntOp<float, true>;
+        return o;
+    case 24: case 25: case 26: case 27:
+        o.d = vfp_get_sd(inst);
+        o.m = dp ? vfp_get_dm(inst) : vfp_get_sm(inst);
+        if (dp)
+            o.fn = idx == 24 ? ToIntOp<double, false, false> : idx == 25 ? ToIntOp<double, false, true>
+                 : idx == 26 ? ToIntOp<double, true, false> : ToIntOp<double, true, true>;
+        else
+            o.fn = idx == 24 ? ToIntOp<float, false, false> : idx == 25 ? ToIntOp<float, false, true>
+                 : idx == 26 ? ToIntOp<float, true, false> : ToIntOp<float, true, true>;
+        return o;
+    default:
+        return o;
+    }
+}
+
+} // namespace VfpNative
+
+#endif
