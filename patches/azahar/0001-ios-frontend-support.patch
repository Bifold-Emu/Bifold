+// Runs one VFP data-processing instruction: on the host FPU inside a VfpNative::GuestWindow
+// (vfp_native.h), otherwise in software.
+inline void VfpCpdo(ARMul_State* cpu, u32 instr, bool dp) {
+    const u32 fpscr = cpu->VFP[VFP_FPSCR];
+#ifdef AZ_VFP_NATIVE
+    if (cpu->vfp_window) {
+        if (!cpu->vfp_live)
+            VfpNative::Enter(cpu);
+        u32 nzcv;
+        if (dp ? VfpNative::Double(cpu, instr, fpscr, nzcv)
+               : VfpNative::Single(cpu, instr, fpscr, nzcv)) {
+            if (nzcv) // comparisons
+                cpu->VFP[VFP_FPSCR] = (fpscr & 0x0FFFFFFF) | nzcv;
+            return;
+        }
+    }
+#endif
+    const u32 ret = dp ? vfp_double_cpdo(cpu, instr, fpscr) : vfp_single_cpdo(cpu, instr, fpscr);
+    vfp_raise_exceptions(cpu, ret, instr, fpscr);
