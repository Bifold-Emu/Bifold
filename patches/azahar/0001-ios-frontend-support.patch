+enum : unsigned {
+    SPECIAL_INST_BASE = 202,
+    ADD_IMM_IDX = SPECIAL_INST_BASE, // ADD{S} Rd, Rn, #imm        Rd, Rn != PC
+    ADD_REG_IDX,                     // ADD{S} Rd, Rn, Rm          Rd, Rn, Rm != PC
+    SUB_IMM_IDX,
+    SUB_REG_IDX,
+    CMP_IMM_IDX,                     // CMP Rn, #imm               Rn != PC
+    CMP_REG_IDX,
+    MOV_IMM_IDX,                     // MOV Rd, #imm               Rd != PC
+    LDR_IMM_IDX,                     // LDR Rd, [Rn, #+-imm]       Rd, Rn != PC
+    LDR_LIT_IDX,                     // LDR Rd, [PC, #+-imm]       Rd != PC
+    STR_IMM_IDX,                     // STR Rd, [Rn, #+-imm]       Rd, Rn != PC
+    LDRB_IMM_IDX,
+    STRB_IMM_IDX,
+    // Register operand shifted by an immediate (LSL #1-31, LSR/ASR #1-31): Rm != PC.
+    ADD_SH_IDX,                      // ADD{S} Rd, Rn, Rm, <shift> #n
+    SUB_SH_IDX,
+    CMP_SH_IDX,
+    MOV_SH_IDX,                      // MOV Rd, Rm, <shift> #n     (no S)
+    ORR_SH_IDX,                      // ORR Rd, Rn, Rm, <shift> #n (no S)
+    AND_IMM_IDX,                     // AND Rd, Rn, #imm           (no S)
+    ORR_IMM_IDX,                     // ORR Rd, Rn, #imm           (no S)
+    RSB_IMM_IDX,                     // RSB{S} Rd, Rn, #imm
+    LDR_REG_IDX,                     // LDR Rd, [Rn, +-Rm, LSL #n] Rd, Rn, Rm != PC
+    STR_REG_IDX,
+    LDRB_REG_IDX,
+    LDM_IDX,                         // LDM{IA,IB,DA,DB} Rn{!}, {list}  (no ^), Rn != PC
+    STM_IDX,                         // STM{IA,IB,DA,DB} Rn{!}, {list}  (no ^), Rn != PC
+    MOV_REG_IDX,                     // MOV Rd, Rm                 (no S)
+    // Immediate offset with writeback, Rd != Rn: post-indexed [Rn], #+-imm and pre-indexed
+    // [Rn, #+-imm]!.
+    LDR_POST_IDX,
+    STR_POST_IDX,
+    LDRB_POST_IDX,
+    STRB_POST_IDX,
+    LDR_PREW_IDX,
+    STR_PREW_IDX,
+    LDRB_PREW_IDX,
+    STRB_PREW_IDX,
+    // The same handlers for unconditional (AL) instructions, in the same order.
+    SPECIAL_AL_BASE,
+    SPECIAL_AL_END = SPECIAL_AL_BASE + (SPECIAL_AL_BASE - SPECIAL_INST_BASE),
+    // Unconditional B and BL (conditional ones stay on the generic BBL handler).
+    B_AL_IDX = SPECIAL_AL_END,
+    BL_AL_IDX,
+    SPECIAL_INST_END
+};
+
+// Cream of the specialised loads and stores, written over their ldst_inst (same block size).
+// offset is added modulo 2^32; for LDR_LIT it is the whole address.
+struct ldst_imm_inst {
+    u32 Rn;
+    u32 Rd;
+    u32 offset;
+};
+static_assert(sizeof(ldst_imm_inst) <= sizeof(ldst_inst));
+// Register-offset form: address = Rn +- (Rm << shift).
+struct ldst_reg_inst {
+    u32 Rn;
+    u32 Rd;
+    u32 Rm;
+    u8 shift;
+    u8 subtract;
+};
+static_assert(sizeof(ldst_reg_inst) <= sizeof(ldst_inst));
+// Block transfer: the first address is Rn + start, Rn becomes Rn + writeback (0 without !).
+struct ldm_stm_inst {
+    u32 list;
+    u32 Rn;
+    u32 start;
+    u32 writeback;
+};
+static_assert(sizeof(ldm_stm_inst) <= sizeof(ldst_inst));
