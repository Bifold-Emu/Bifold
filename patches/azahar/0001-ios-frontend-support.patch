+#ifdef ENABLE_GDBSTUB // breakpoints are not checked on this path
+#undef GDB_BP_CHECK
+#define GDB_BP_CHECK
+#endif
+#undef FETCH_INST
+#undef GOTO_NEXT_INST
+#define TC_GOTO_DISPATCH [[clang::musttail]] return TC_DISPATCH(TC_PASS)
+#define TC_GOTO_END [[clang::musttail]] return TC_END(TC_PASS)
+#define FETCH_INST                                                                                 \
+    if (inst_base->br != TransExtData::NON_BRANCH) {                                               \
+        TC_GOTO_DISPATCH;                                                                          \
+    }                                                                                              \
+    inst_base = (arm_inst*)&trans_cache_buf[ptr]
+#define GOTO_NEXT_INST                                                                             \
+    if (num_instrs >= cpu->NumInstrsToExecute) {                                                   \
+        TC_GOTO_END;                                                                               \
+    }                                                                                              \
+    num_instrs++;                                                                                  \
+    [[clang::musttail]] return tc_table[inst_base->idx](TC_PASS)
+
+static TC_CC unsigned TC_DISPATCH(TC_ARGS) {
+    [[maybe_unused]] unsigned int addr;
+#ifdef ENABLE_GDBSTUB
+    [[maybe_unused]] GDBStub::BreakpointAddress breakpoint_data{};
+#endif
+    if (!cpu->NirqSig) {
+        if (!(cpu->Cpsr & 0x80)) {
+            TC_GOTO_END;
+        }
+    }
+
+    if (cpu->TFlag)
+        cpu->Reg[15] &= 0xfffffffe;
+    else
+        cpu->Reg[15] &= 0xfffffffc;
+
+    // Find the cached instruction cream, otherwise translate it...
+    {
+        const u32 pc = cpu->Reg[15];
+        auto& fast = cpu->fast_block_cache[(pc >> 1) & (cpu->fast_block_cache.size() - 1)];
+        if (fast.pc == pc && fast.generation == cpu->block_cache_generation) [[likely]] {
+            ptr = fast.ptr;
+        } else {
+            auto itr = cpu->instruction_cache.find(pc);
+            if (itr != cpu->instruction_cache.end()) {
+                ptr = itr->second;
+            } else if (cpu->NumInstrsToExecute != 1) {
+                if (InterpreterTranslateBlock(cpu, ptr, pc) == FETCH_EXCEPTION)
+                    TC_GOTO_END;
+            } else {
+                if (InterpreterTranslateSingle(cpu, ptr, pc) == FETCH_EXCEPTION)
+                    TC_GOTO_END;
+            }
+            // Single-step translations are not shared with normal execution: they end after
+            // one instruction, so only blocks found in or added to the map are cached here.
+            if (cpu->NumInstrsToExecute != 1) {
+                fast = {pc, cpu->block_cache_generation, ptr};
+            }
+        }
+    }
+
+#ifdef ENABLE_GDBSTUB
+    // Find breakpoint if one exists within the block
+    if (GDBStub::IsConnected()) {
+        breakpoint_data =
+            GDBStub::GetNextBreakpointFromAddress(cpu->Reg[15], GDBStub::BreakpointType::Execute);
+    }
+#endif
+
+    inst_base = (arm_inst*)&trans_cache_buf[ptr];
+    GOTO_NEXT_INST;
+}
+
+static TC_CC unsigned TC_ADC_INST(TC_ARGS) {
+    [[maybe_unused]] unsigned int addr;
+    if (inst_base->cond == ConditionCode::AL || CondPassed(cpu, inst_base->cond)) {
+        adc_inst* const inst_cream = (adc_inst*)inst_base->component;
+
+        u32 rn_val = RN;
+        if (inst_cream->Rn == 15)
+            rn_val += 2 * cpu->GetInstructionSize();
+
+        bool carry;
+        bool overflow;
+        RD = AddWithCarry(rn_val, SHIFTER_OPERAND, cpu->CFlag, &carry, &overflow);
+
+        if (inst_cream->S && (inst_cream->Rd == 15)) {
+            if (cpu->CurrentModeHasSPSR()) {
+                cpu->Cpsr = cpu->Spsr_copy;
+                cpu->ChangePrivilegeMode(cpu->Spsr_copy & 0x1F);
+                LOAD_NZCVT;
+            }
+        } else if (inst_cream->S) {
+            UPDATE_NFLAG(RD);
+            UPDATE_ZFLAG(RD);
+            cpu->CFlag = carry;
+            cpu->VFlag = overflow;
+        }
+        if (inst_cream->Rd == 15) {
+            INC_PC(sizeof(adc_inst));
+            TC_GOTO_DISPATCH;
+        }
+    }
+    cpu->Reg[15] += cpu->GetInstructionSize();
+    INC_PC(sizeof(adc_inst));
+    FETCH_INST;
+    GOTO_NEXT_INST;
+}
+
+static TC_CC unsigned TC_ADD_INST(TC_ARGS) {
+    [[maybe_unused]] unsigned int addr;
+    if (inst_base->cond == ConditionCode::AL || CondPassed(cpu, inst_base->cond)) {
+        add_inst* const inst_cream = (add_inst*)inst_base->component;
+
+        u32 rn_val = CHECK_READ_REG15_WA(cpu, inst_cream->Rn);
+
+        bool carry;
+        bool overflow;
+        RD = AddWithCarry(rn_val, SHIFTER_OPERAND, 0, &carry, &overflow);
+
+        if (inst_cream->S && (inst_cream->Rd == 15)) {
+            if (cpu->CurrentModeHasSPSR()) {
+                cpu->Cpsr = cpu->Spsr_copy;
+                cpu->ChangePrivilegeMode(cpu->Cpsr & 0x1F);
+                LOAD_NZCVT;
+            }
+        } else if (inst_cream->S) {
+            UPDATE_NFLAG(RD);
+            UPDATE_ZFLAG(RD);
+            cpu->CFlag = carry;
+            cpu->VFlag = overflow;
+        }
+        if (inst_cream->Rd == 15) {
+            INC_PC(sizeof(add_inst));
