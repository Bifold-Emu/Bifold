+        u32 lop = RN;
+        u32 rop = SHIFTER_OPERAND;
+
+        if (inst_cream->Rn == 15)
+            lop += cpu->GetInstructionSize() * 2;
+
+        u32 result = lop & rop;
+
+        UPDATE_NFLAG(result);
+        UPDATE_ZFLAG(result);
+        UPDATE_CFLAG_WITH_SC;
+    }
+    cpu->Reg[15] += cpu->GetInstructionSize();
+    INC_PC(sizeof(tst_inst));
+    FETCH_INST;
+    GOTO_NEXT_INST;
+}
