+        // REV16
+        else if (op1 == 0x03 && op2 == 0x05) {
+            RD = ((RM & 0xFF) << 8) | ((RM & 0xFF00) >> 8) | ((RM & 0xFF0000) << 8) |
+                 ((RM & 0xFF000000) >> 8);
+        }
+        // REVSH
+        else if (op1 == 0x07 && op2 == 0x05) {
+            RD = ((RM & 0xFF) << 8) | ((RM & 0xFF00) >> 8);
+            if (RD & 0x8000)
+                RD |= 0xffff0000;
