+// The translation buffer is shared by every ARMul_State (one per emulated core). Clearing one
+// core's block map must not reset the buffer, or the other cores' maps would point at reused
+// memory; instead the buffer is reset (and every core's map cleared) only when it fills up.
+void RegisterTransCacheUser(ARMul_State* state);
+void UnregisterTransCacheUser(ARMul_State* state);
