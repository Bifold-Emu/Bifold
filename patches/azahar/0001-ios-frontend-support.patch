+/**
+ * Output stream buffer that Zstandard-compresses (default level) everything written to it into
+ * one frame and hands the compressed bytes to `sink` in chunks. Lets large data (save states) be
+ * compressed while it is produced, without first holding all of it uncompressed in memory.
+ * The frame does not record its decompressed size; read it with ZstdDecompressStreamBuf.
+ */
+class ZstdCompressStreamBuf final : public std::streambuf {
+public:
+    using Sink = std::function<bool(const u8* data, std::size_t size)>;
+
+    explicit ZstdCompressStreamBuf(Sink sink);
+    ~ZstdCompressStreamBuf() override;
+
+    /// Ends the frame. Returns false if compressing or the sink failed at any point.
+    [[nodiscard]] bool Finish();
+
+protected:
+    int_type overflow(int_type ch) override;
+    int sync() override;
+
+private:
+    bool Drain(int end_directive);
+
+    Sink sink;
+    void* context;
+    std::vector<char> input;
+    std::vector<char> output;
+    bool ok = true;
+};
+
+/**
+ * Input stream buffer that decompresses Zstandard data chunk by chunk as it is read, with or
+ * without a decompressed size in the frame header.
+ */
+class ZstdDecompressStreamBuf final : public std::streambuf {
+public:
+    explicit ZstdDecompressStreamBuf(std::span<const u8> compressed);
+    ~ZstdDecompressStreamBuf() override;
+
+    [[nodiscard]] bool Failed() const {
+        return failed;
+    }
+
+protected:
+    int_type underflow() override;
+
+private:
+    void* context;
+    std::span<const u8> source;
+    std::size_t source_pos = 0;
+    std::vector<char> output;
+    bool failed = false;
+};
+
 } // namespace Common::Compression
 
