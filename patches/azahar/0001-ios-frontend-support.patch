+#ifdef AZ_VFP_NATIVE
+            if (cpu->vfp_live) // new mode; flags collected so far are overwritten
+                VfpNative::Load(cpu);
+#endif
+        } else if (cpu->InAPrivilegedMode()) {
+            if (reg == 8)
+                cpu->VFP[VFP_FPEXC] = cpu->Reg[rt];
+            else if (reg == 9)
+                cpu->VFP[VFP_FPINST] = cpu->Reg[rt];
+            else if (reg == 10)
+                cpu->VFP[VFP_FPINST2] = cpu->Reg[rt];
+        }
+    }
