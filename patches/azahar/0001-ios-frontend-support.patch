+static void SpecializeForm(arm_inst* inst_base, u32 inst, u32 pc) {
+    const transop_fp_t op = arm_instruction_trans[inst_base->idx];
+    const u32 Rn = BITS(inst, 16, 19);
+    const u32 Rd = BITS(inst, 12, 15);
+    const u32 Rm = BITS(inst, 0, 3);
