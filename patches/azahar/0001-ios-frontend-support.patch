+                    inst_base = (arm_inst*)&trans_cache_buf[ptr];
+                    GOTO_NEXT_INST;
+                }
+            }
+#endif
+            goto DISPATCH;
+        }
+    }
+    cpu->Reg[15] += 4;
+    INC_PC(sizeof(ldst_inst));
+    FETCH_INST;
+    GOTO_NEXT_INST;
