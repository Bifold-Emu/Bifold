+static TC_CC unsigned TC_BBL_INST(TC_ARGS) {
+    [[maybe_unused]] unsigned int addr;
+    bbl_inst* inst_cream = (bbl_inst*)inst_base->component;
+    BlockLink* link = &inst_cream->link[1];
+    if ((inst_base->cond == ConditionCode::AL) || CondPassed(cpu, inst_base->cond)) {
+        if (inst_cream->L) {
+            LINK_RTN_ADDR;
+            PushReturn(cpu, cpu->Reg[14], &inst_cream->link[1]); // link[1] is the block at pc + 4
+        }
+        SET_PC;
+        link = &inst_cream->link[0];
+    } else {
+        cpu->Reg[15] += 4; // BBL is ARM only (Thumb branches have their own handlers)
+    }
+    INC_PC(sizeof(bbl_inst));
+#ifndef ENABLE_GDBSTUB // a linked block skips the breakpoint lookup at dispatch
+    // Both targets are fixed, so the block found the first time is reused while the block
+    // cache generation is unchanged. The interrupt check is the one at dispatch. Links are only
+    // made while linking is on; turning it off clears the block caches, which drops them.
+    if (cpu->NirqSig || (cpu->Cpsr & 0x80)) {
+        if (link->gen == cpu->block_cache_generation) [[likely]] {
+            ptr = link->ptr;
+        } else {
+            const std::size_t block = g_dyncom_link.load(std::memory_order_relaxed)
+                                          ? LookupCachedBlock(cpu, cpu->Reg[15])
+                                          : NO_BLOCK;
+            if (block == NO_BLOCK) {
+                TC_GOTO_DISPATCH;
+            }
+            *link = {cpu->block_cache_generation, static_cast<u32>(block)};
+            ptr = block;
+        }
+        inst_base = (arm_inst*)&trans_cache_buf[ptr];
+        GOTO_NEXT_INST;
+    }
+#endif
+    TC_GOTO_DISPATCH;
+}
