index 0000000..0868d86
--- /dev/null
+++ b/src/core/arm/skyeye_common/vfp/vfp_native_op.h
@@ -0,0 +1,23 @@
+// Bifold: the per-instruction operation that vfp_native.h decodes at translation time. Kept
+// apart from vfp_native.h so the interpreter's instruction structs (arm_dyncom_trans.h) can hold
+// one without pulling in ARMul_State.
+#pragma once
+
+#include "common/common_types.h"
+
+struct ARMul_State;
+
+#if defined(__aarch64__)
+namespace VfpNative {
+struct Op;
+using OpFn = void (*)(ARMul_State*, const Op&);
+struct Op {
+    OpFn fn = nullptr; // nullptr: not handled here (VfpCpdo decides)
+    u8 d = 0, n = 0, m = 0;
+    bool any_len = false; // scalar whatever FPSCR.LEN says (comparisons, conversions, bank 0)
+};
+} // namespace VfpNative
+#define VFP_NATIVE_OP VfpNative::Op op;
+#else
+#define VFP_NATIVE_OP
+#endif
