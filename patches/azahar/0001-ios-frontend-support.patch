+// Block transfers (ldm_stm_inst). As the generic LDM/STM: the base is written back first, STM
+// stores the old base when it is in the list, PC is stored as PC + 8, and a loaded PC sets the
+// Thumb bit from bit 0. When the whole transfer lies in one plain-memory page it is done with
+// one page lookup instead of one per register.
+LDM_FAST_INST: {
+    if (inst_base->cond == ConditionCode::AL || CondPassed(cpu, inst_base->cond)) {
+        const ldm_stm_inst* const inst_cream = (const ldm_stm_inst*)inst_base->component;
+        const u32 base = cpu->Reg[inst_cream->Rn];
+        u32 vaddr = base + inst_cream->start;
+        cpu->Reg[inst_cream->Rn] = base + inst_cream->writeback;
+        u32 list = inst_cream->list;
+        const u32 bytes = 4 * static_cast<u32>(std::popcount(list));
+        const u8* page = cpu->FastPage(vaddr);
+        if (page && (vaddr & ARMul_State::PAGE_OFFSET_MASK) + bytes <= ARMul_State::PAGE_OFFSET_MASK + 1 &&
+            !cpu->InBigEndianMode()) [[likely]] {
+            const u8* p = page + (vaddr & ARMul_State::PAGE_OFFSET_MASK);
+            for (; list != 0; list &= list - 1, p += 4) {
+                u32 value;
+                std::memcpy(&value, p, sizeof(value));
+                cpu->Reg[std::countr_zero(list)] = value;
+            }
+        } else {
+            for (; list != 0; list &= list - 1, vaddr += 4) {
+                cpu->Reg[std::countr_zero(list)] = cpu->ReadMemory32(vaddr);
+            }
+        }
+        if (inst_cream->list & 0x8000) {
+            cpu->TFlag = cpu->Reg[15] & 0x1;
+            cpu->Reg[15] &= 0xFFFFFFFE;
+            INC_PC(sizeof(ldst_inst));
