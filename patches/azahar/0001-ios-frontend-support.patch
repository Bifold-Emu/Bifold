+namespace {
+/// A save state can contain absolute host paths from another location of the user directory
+/// (states written before paths were stored relative to it, or by a frontend that does not use
+/// FileUtil::Path everywhere). On iOS this is routine: the app's data container gets a new path
+/// when the app is reinstalled or updated, so every path in an older state points to a directory
+/// the app can no longer reach (the game's own save then fails with "not formatted").
+/// Rebase such a path onto the current user directory when its tail matches the user directory's
+/// last two components (e.g. ".../<old container>/Documents/Azahar/sdmc/..." ->
+/// ".../<new container>/Documents/Azahar/sdmc/...").
+std::string RebaseForeignUserPath(const std::string& path) {
+    const std::string& user_dir = GetUserPath(UserPath::UserDir);
+    if (path.empty() || path.front() != '/' || user_dir.empty() || path.starts_with(user_dir)) {
+        return path;
+    }
+    // Last two components of the user directory, with separators: "/Documents/Azahar/".
+    std::size_t end = user_dir.size();
+    if (user_dir.back() == '/') {
+        --end;
+    }
+    std::size_t cut = user_dir.rfind('/', end - 1);
+    if (cut != std::string::npos && cut > 0) {
+        cut = user_dir.rfind('/', cut - 1);
+    }
+    if (cut == std::string::npos) {
+        return path;
+    }
+    const std::string tail = user_dir.substr(cut); // starts and ends with '/'
+    const std::size_t at = path.find(tail);
+    if (at == std::string::npos) {
+        return path;
+    }
+    return user_dir + path.substr(at + tail.size());
+}
+} // namespace
+
 std::string SerializePath(const std::string& input, bool is_saving) {
     auto result = input;
     StringReplace(result, "%CITRA_ROM_FILE%", g_currentRomPath, is_saving);
     StringReplace(result, "%CITRA_USER_DIR%", GetUserPath(UserPath::UserDir), is_saving);
     StringReplace(result, "%CITRA_USER_SDMC%", GetUserPath(UserPath::SDMCDir), is_saving);
     StringReplace(result, "%CITRA_USER_NAND%", GetUserPath(UserPath::NANDDir), is_saving);
+    if (!is_saving) {
+        result = RebaseForeignUserPath(result);
+    }
     return result;
 }
 
