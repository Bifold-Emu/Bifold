@@ -48,6 +48,24 @@ KernelSystem::KernelSystem(Memory::MemorySystem& memory, Core::Timing& timing,
 
 /// Shutdown the kernel
 KernelSystem::~KernelSystem() {
+    // Break the reference cycles between kernel objects so that nothing outlives the kernel. A
+    // thread sleeping in an HLE service call owns its request context (wakeup_callback), and the
+    // context owns the thread again and the client process (through its mapped buffers); waiting
+    // threads and the objects they wait on, and mutexes and their holders, also reference each
+    // other. Without this, loading a save state while a thread was in such a wait (frequent:
+    // games stream data from the file system) leaked the whole previous game process: page
+    // table, code set and more, ~60 MB per load in Pokemon Sun, until iOS killed the app.
+    for (auto& manager : thread_managers) {
+        if (!manager) {
+            continue;
+        }
+        for (const auto& thread : manager->GetThreadList()) {
+            thread->wakeup_callback.reset();
+            thread->wait_objects.clear();
+            thread->held_mutexes.clear();
+            thread->pending_mutexes.clear();
+        }
+    }
     ResetThreadIDs();
 };
 
