+                cpu->WriteMemory32(addr + 4, word1);
+            } else {
+                cpu->WriteMemory32(addr + 0, word1);
+                cpu->WriteMemory32(addr + 4, word2);
+            }
+        }
+    }
+    cpu->Reg[15] += cpu->GetInstructionSize();
+    INC_PC(sizeof(vstr_inst));
+    FETCH_INST;
+    GOTO_NEXT_INST;
