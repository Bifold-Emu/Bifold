+ZstdCompressStreamBuf::ZstdCompressStreamBuf(Sink sink_)
+    : sink(std::move(sink_)), context(ZSTD_createCCtx()), input(1 << 20),
+      output(ZSTD_CStreamOutSize()) {
+    if (!context) {
+        ok = false;
+    } else {
+        ZSTD_CCtx_setParameter(static_cast<ZSTD_CCtx*>(context), ZSTD_c_compressionLevel,
+                               ZSTD_CLEVEL_DEFAULT);
+    }
+    setp(input.data(), input.data() + input.size());
+}
+
+ZstdCompressStreamBuf::~ZstdCompressStreamBuf() {
+    ZSTD_freeCCtx(static_cast<ZSTD_CCtx*>(context));
+}
+
+bool ZstdCompressStreamBuf::Drain(int end_directive) {
+    if (!ok) {
+        setp(input.data(), input.data() + input.size());
+        return false;
+    }
+    const auto mode = static_cast<ZSTD_EndDirective>(end_directive);
+    ZSTD_inBuffer in{pbase(), static_cast<std::size_t>(pptr() - pbase()), 0};
+    for (;;) {
+        ZSTD_outBuffer out{output.data(), output.size(), 0};
+        const std::size_t remaining =
+            ZSTD_compressStream2(static_cast<ZSTD_CCtx*>(context), &out, &in, mode);
+        if (ZSTD_isError(remaining)) {
+            LOG_ERROR(Common, "Error compressing ZSTD stream: {}", ZSTD_getErrorName(remaining));
+            ok = false;
+            break;
+        }
+        if (out.pos != 0 && !sink(reinterpret_cast<const u8*>(output.data()), out.pos)) {
+            ok = false;
+            break;
+        }
+        const bool done = mode == ZSTD_e_continue ? in.pos == in.size : remaining == 0;
+        if (done) {
+            break;
+        }
+    }
+    setp(input.data(), input.data() + input.size());
+    return ok;
+}
+
+ZstdCompressStreamBuf::int_type ZstdCompressStreamBuf::overflow(int_type ch) {
+    if (!Drain(ZSTD_e_continue)) {
+        return traits_type::eof();
+    }
+    if (!traits_type::eq_int_type(ch, traits_type::eof())) {
+        *pptr() = traits_type::to_char_type(ch);
+        pbump(1);
+    }
+    return traits_type::not_eof(ch);
+}
+
+int ZstdCompressStreamBuf::sync() {
+    return Drain(ZSTD_e_flush) ? 0 : -1;
+}
+
+bool ZstdCompressStreamBuf::Finish() {
+    return Drain(ZSTD_e_end);
+}
+
+ZstdDecompressStreamBuf::ZstdDecompressStreamBuf(std::span<const u8> compressed)
+    : context(ZSTD_createDCtx()), source(compressed), output(ZSTD_DStreamOutSize()) {
+    failed = context == nullptr;
+    setg(output.data(), output.data(), output.data());
+}
+
+ZstdDecompressStreamBuf::~ZstdDecompressStreamBuf() {
+    ZSTD_freeDCtx(static_cast<ZSTD_DCtx*>(context));
+}
+
+ZstdDecompressStreamBuf::int_type ZstdDecompressStreamBuf::underflow() {
+    if (gptr() < egptr()) {
+        return traits_type::to_int_type(*gptr());
+    }
+    while (!failed) {
+        ZSTD_inBuffer in{source.data(), source.size(), source_pos};
+        ZSTD_outBuffer out{output.data(), output.size(), 0};
+        const std::size_t result =
+            ZSTD_decompressStream(static_cast<ZSTD_DCtx*>(context), &out, &in);
+        source_pos = in.pos;
+        if (ZSTD_isError(result)) {
+            LOG_ERROR(Common, "Error decompressing ZSTD stream: {}", ZSTD_getErrorName(result));
+            failed = true;
+            break;
+        }
+        if (out.pos != 0) {
+            setg(output.data(), output.data(), output.data() + out.pos);
+            return traits_type::to_int_type(*gptr());
+        }
+        if (in.pos == in.size) {
+            break; // no input left and nothing more buffered
+        }
+    }
+    return traits_type::eof();
+}
+
 std::vector<u8> DecompressDataZSTD(std::span<const u8> compressed) {
     const std::size_t decompressed_size = GetDecompressedSize(compressed);
 
