+    if (op.fn && cpu->vfp_window && VfpNative::predecoded.load(std::memory_order_relaxed) &&
+        (op.any_len || (cpu->VFP[VFP_FPSCR] & FPSCR_LENGTH_MASK) == 0)) {
+        if (!cpu->vfp_live)
+            VfpNative::Enter(cpu);
+        op.fn(cpu, op);
+        return;
+    }
+    VfpCpdo(cpu, instr, dp);
