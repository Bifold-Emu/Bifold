+// Inline: the interpreter calls this for every ADD/SUB/CMP-style instruction.
+inline u32 AddWithCarry(u32 left, u32 right, u32 carry_in, bool* carry_out_occurred,
+                        bool* overflow_occurred) {
+    const u64 unsigned_sum = u64{left} + u64{right} + u64{carry_in};
+    const u32 result = static_cast<u32>(unsigned_sum);
+    if (carry_out_occurred)
+        *carry_out_occurred = (unsigned_sum >> 32) != 0;
+    if (overflow_occurred) // operands of equal sign, result of the other sign
+        *overflow_occurred = (((left ^ result) & (right ^ result)) >> 31) != 0;
+    return result;
+}
