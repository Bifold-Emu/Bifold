+static TC_CC unsigned TC_CPS_INST(TC_ARGS) {
+    [[maybe_unused]] unsigned int addr;
+    cps_inst* inst_cream = (cps_inst*)inst_base->component;
+    u32 aif_val = 0;
+    u32 aif_mask = 0;
+    if (cpu->InAPrivilegedMode()) {
+        if (inst_cream->imod1) {
+            if (inst_cream->A) {
+                aif_val |= (inst_cream->imod0 << 8);
+                aif_mask |= 1 << 8;
+            }
+            if (inst_cream->I) {
+                aif_val |= (inst_cream->imod0 << 7);
+                aif_mask |= 1 << 7;
+            }
+            if (inst_cream->F) {
+                aif_val |= (inst_cream->imod0 << 6);
+                aif_mask |= 1 << 6;
+            }
+            aif_mask = ~aif_mask;
+            cpu->Cpsr = (cpu->Cpsr & aif_mask) | aif_val;
+        }
+        if (inst_cream->mmod) {
+            cpu->Cpsr = (cpu->Cpsr & 0xffffffe0) | inst_cream->mode;
+            cpu->ChangePrivilegeMode(inst_cream->mode);
+        }
+    }
+    cpu->Reg[15] += cpu->GetInstructionSize();
