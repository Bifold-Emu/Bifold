+        }
+        if (inst_cream->Rd == 15) {
+            INC_PC(sizeof(rsc_inst));
+            TC_GOTO_DISPATCH;
+        }
+    }
+    cpu->Reg[15] += cpu->GetInstructionSize();
+    INC_PC(sizeof(rsc_inst));
+    FETCH_INST;
+    GOTO_NEXT_INST;
+}
