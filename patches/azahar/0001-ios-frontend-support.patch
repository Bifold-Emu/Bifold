+        if (inst_cream->single) {
+            cpu->WriteMemory32(addr, cpu->ExtReg[inst_cream->d]);
+        } else {
+            const u32 word1 = cpu->ExtReg[inst_cream->d * 2 + 0];
+            const u32 word2 = cpu->ExtReg[inst_cream->d * 2 + 1];
