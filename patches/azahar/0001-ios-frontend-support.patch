+        } else {
+            idx = op == INTERPRETER_TRANSLATE(ldrb) ? LDRB_IMM_IDX : STRB_IMM_IDX;
+        }
+        ldst_imm_inst* cream = (ldst_imm_inst*)inst_base->component;
+        *cream = {Rn, Rd, offset};
+        inst_base->idx = idx;
+    }
+}
