diff --git a/src/dynarmic/backend/arm64/a32_address_space.cpp b/src/dynarmic/backend/arm64/a32_address_space.cpp
index bbdf925..4591af6 100644
--- a/src/dynarmic/backend/arm64/a32_address_space.cpp
+++ b/src/dynarmic/backend/arm64/a32_address_space.cpp
@@ -5,6 +5,8 @@
 
 #include "dynarmic/backend/arm64/a32_address_space.h"
 
+#include <cstdlib>
+
 #include "dynarmic/backend/arm64/a32_jitstate.h"
 #include "dynarmic/backend/arm64/abi.h"
 #include "dynarmic/backend/arm64/devirtualize.h"
@@ -318,12 +320,28 @@ void A32AddressSpace::EmitPrelude() {
 
         code.LDR(X0, l_this);
         code.MOV(X1, Xstate);
+        code.MOV(X2, SP);  // StackLayout of the current run
         code.LDR(Xscratch0, l_addr);
         code.BLR(Xscratch0);
         code.BR(X0);
 
-        const auto fn = [](A32AddressSpace& self, A32JitState& context) -> CodePtr {
-            return self.GetOrEmit(context.GetLocationDescriptor());
+        const auto fn = [](A32AddressSpace& self, A32JitState& context, StackLayout& stack) -> CodePtr {
+            const u64 clears = self.GetClearCount();
+            const CodePtr entry = self.GetOrEmit(context.GetLocationDescriptor());
+            // DYNARMIC_NO_RSB_RESET=1 disables the reset (test hook to reproduce the bug).
+            static const bool reset_disabled = std::getenv("DYNARMIC_NO_RSB_RESET") != nullptr;
+            if (self.GetClearCount() != clears && !reset_disabled) {
+                // The code cache filled up and was wiped while compiling this block, in the
+                // middle of a run. The return stack buffer still holds host pointers into the
+                // old code, which is now being overwritten by new blocks; returning through one
+                // of them executes unrelated code (seen as a guest jump to address 0 in Pokemon
+                // Sun with a 16 MiB cache). Point every entry back at the dispatcher.
+                for (auto& entry_rsb : stack.rsb) {
+                    entry_rsb.target = 0xFFFF'FFFF'FFFF'FFFFull;
+                    entry_rsb.code_ptr = mcl::bit_cast<u64>(self.prelude_info.return_to_dispatcher);
+                }
+            }
+            return entry;
         };
 
         code.align(8);
